{
  "name": "TravelMatch - Password Reset",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "travelmatch-password-reset",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "2a8f0f1a-0002-4a3e-9b1a-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 0],
      "webhookId": "travelmatch-password-reset"
    },
    {
      "parameters": {
        "jsCode": "const { email, resetUrl } = $input.first().json.body;\n\nconst html = `\n  <div style=\"font-family:sans-serif;max-width:480px;margin:0 auto;\">\n    <h2>✈️ Reset your TravelMatch password</h2>\n    <p style=\"color:#333;\">We received a request to reset your password. This link expires in 1 hour and can only be used once.</p>\n    <p style=\"margin:24px 0;\">\n      <a href=\"${resetUrl}\" style=\"background:#aa3bff;color:#fff;padding:12px 24px;border-radius:999px;text-decoration:none;font-weight:600;\">Reset password</a>\n    </p>\n    <p style=\"color:#777;font-size:13px;\">If you didn't request this, you can safely ignore this email — your password won't change.</p>\n  </div>`;\n\nreturn [{ json: { email, html } }];"
      },
      "id": "2a8f0f1a-0002-4a3e-9b1a-000000000002",
      "name": "Format Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, 0]
    },
    {
      "parameters": {
        "fromEmail": "travelmatch@example.com",
        "toEmail": "={{ $json.email }}",
        "subject": "Reset your TravelMatch password",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "2a8f0f1a-0002-4a3e-9b1a-000000000003",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [240, 0],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Format Email", "type": "main", "index": 0 }]]
    },
    "Format Email": {
      "main": [[{ "node": "Send Email", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
